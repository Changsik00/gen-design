{
  "name": "studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm fixtures:gen && vite",
    "tokens": "node tokens/build.mjs",
    "fixtures:gen": "tsx scripts/generate-fixtures-index.ts",
    "build": "pnpm fixtures:gen && node tokens/build.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "vocab": "tsx scripts/extract-vocabulary.ts",
    "vocab:check": "tsx scripts/extract-vocabulary.ts --check",
    "chat-lint": "tsx src/lib/chat-md/cli/spec-lint.ts",
    "chat-paper": "tsx --tsconfig tsconfig.app.json src/lib/chat-md-compiler/cli/spec-paper.ts",
    "paper-to-chat": "tsx --tsconfig tsconfig.app.json src/lib/paper-inference/cli/paper-to-spec.ts",
    "paper-inference:bench": "vitest run src/lib/paper-inference/__tests__/benchmark.test.ts",
    "chat-react": "tsx --tsconfig tsconfig.app.json src/lib/chat-md-compiler/react/cli/spec-react.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "peggy": "^5.1.0",
    "style-dictionary": "^5.4.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
