{
  "name": "create-gd-react",
  "version": "0.1.0",
  "description": "Scaffold a React project with gen-design (gd) integrated",
  "type": "module",
  "bin": {
    "create-gd-react": "./dist/cli.js"
  },
  "files": [
    "dist",
    "presets-bundled"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node20 --clean --shims",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "kleur": "^4.1.5",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/tar": "^6.1.13",
    "tsup": "^8.3.5",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "gen-design",
    "scaffold",
    "react",
    "shadcn",
    "tailwind",
    "designer"
  ],
  "license": "MIT"
}
