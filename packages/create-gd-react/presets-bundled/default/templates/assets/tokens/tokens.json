{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "primary": {
      "$value": "#4F46E5",
      "$type": "color",
      "$description": "Brand primary — indigo 600 (WCAG AA 5.8:1 with white)"
    },
    "background": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "Page background — neutral 0"
    },
    "foreground": {
      "$value": "#0F172A",
      "$type": "color",
      "$description": "Body text — neutral 900"
    },
    "muted": {
      "$value": "#F1F5F9",
      "$type": "color",
      "$description": "Secondary surface — neutral 100"
    },
    "muted-foreground": {
      "$value": "#475569",
      "$type": "color",
      "$description": "Secondary text — neutral 600 (WCAG AA 8.7:1 on bg-muted)"
    },
    "border": {
      "$value": "#E2E8F0",
      "$type": "color",
      "$description": "Outline — neutral 200"
    },
    "destructive": {
      "$value": "#B91C1C",
      "$type": "color",
      "$description": "Error/danger — red 700 (WCAG AA 6.4:1 on bg-destructive/10)"
    },
    "destructive-foreground": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "Text on destructive bg"
    }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "2xl": { "$value": "48px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" }
  },
  "fontFamily": {
    "sans": {
      "$value": "Inter, system-ui, -apple-system, sans-serif",
      "$type": "fontFamily"
    }
  }
}
