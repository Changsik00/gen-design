{
  "$schema": "https://design-tokens.org/schema.json",
  "$comment": "DESIGN.md (poc/app-a/DESIGN.md) §13 의 정확값 기반. spec-5-02 의 Paper 추출 결과 채움.",
  "semantic": {
    "color": {
      "$type": "color",
      "light": {
        "primary": { "$value": "#4F46E5" },
        "primary-hover": { "$value": "#4338CA" },
        "primary-active": { "$value": "#3730A3" },
        "primary-subtle": { "$value": "#EEF2FF" },
        "primary-foreground": { "$value": "#FFFFFF" },
        "accent": { "$value": "#0EA5B7" },
        "accent-foreground": { "$value": "#FFFFFF" },

        "background": { "$value": "#FFFFFF" },
        "foreground": { "$value": "#0F172A" },
        "card": { "$value": "#FFFFFF" },
        "card-foreground": { "$value": "#0F172A" },
        "popover": { "$value": "#FFFFFF" },
        "popover-foreground": { "$value": "#0F172A" },

        "muted": { "$value": "#F8FAFC" },
        "muted-foreground": { "$value": "#64748B" },
        "secondary": { "$value": "#F1F5F9" },
        "secondary-foreground": { "$value": "#0F172A" },

        "text": { "$value": "#0F172A" },
        "text-secondary": { "$value": "#334155" },
        "text-tertiary": { "$value": "#64748B" },
        "text-placeholder": { "$value": "#94A3B8" },

        "surface": { "$value": "#FFFFFF" },
        "surface-alt": { "$value": "#F8FAFC" },
        "divider-soft": { "$value": "#F1F5F9" },
        "border": { "$value": "#E2E8F0" },
        "input": { "$value": "#E2E8F0" },
        "ring": { "$value": "#4F46E5" },

        "success": { "$value": "#16A34A" },
        "success-fg": { "$value": "#16A34A" },
        "success-bg": { "$value": "#DCFCE7" },
        "success-strong": { "$value": "#166534" },

        "error": { "$value": "#DC2626" },
        "error-fg": { "$value": "#DC2626" },
        "error-bg": { "$value": "#FEE2E2" },
        "error-strong": { "$value": "#991B1B" },
        "error-soft-bg": { "$value": "#FEF2F2" },
        "error-soft-border": { "$value": "#FECACA" },
        "error-soft-fg": { "$value": "#B91C1C" },

        "destructive": { "$value": "#DC2626" },
        "destructive-foreground": { "$value": "#FFFFFF" },

        "sidebar": { "$value": "#0F172A" },
        "sidebar-foreground": { "$value": "#F1F5F9" },
        "sidebar-primary": { "$value": "#4F46E5" },
        "sidebar-primary-foreground": { "$value": "#FFFFFF" },
        "sidebar-accent": { "$value": "#1E293B" },
        "sidebar-accent-foreground": { "$value": "#F1F5F9" },
        "sidebar-border": { "$value": "#1E293B" },
        "sidebar-ring": { "$value": "#4F46E5" }
      }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "6px" },
      "md": { "$value": "8px" },
      "lg": { "$value": "12px" },
      "xl": { "$value": "16px" }
    },
    "spacing": {
      "$type": "dimension",
      "xs": { "$value": "4px" },
      "sm": { "$value": "8px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "24px" },
      "xl": { "$value": "32px" }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": "Inter, ui-sans-serif, system-ui, sans-serif" },
        "mono": {
          "$value": "ui-monospace, SFMono-Regular, \"JetBrains Mono\", Menlo, monospace"
        }
      },
      "size": {
        "$type": "dimension",
        "display": { "$value": "36px" },
        "h1": { "$value": "28px" },
        "h2": { "$value": "22px" },
        "h3": { "$value": "18px" },
        "body": { "$value": "14px" },
        "caption": { "$value": "12px" },
        "mono": { "$value": "13px" }
      }
    },
    "elevation": {
      "$type": "shadow",
      "card": { "$value": "0 1px 2px rgba(15, 23, 42, 0.04)" },
      "modal": {
        "$value": "0 12px 32px rgba(15, 23, 42, 0.18), 0 2px 6px rgba(15, 23, 42, 0.08)"
      },
      "avatar-glow": {
        "$value": "0 1px 2px rgba(15, 23, 42, 0.06), 0 4px 12px rgba(67, 56, 202, 0.18)"
      },
      "knob": { "$value": "0 1px 2px rgba(15, 23, 42, 0.2)" },
      "handle": { "$value": "0 1px 3px rgba(15, 23, 42, 0.12)" }
    }
  }
}
