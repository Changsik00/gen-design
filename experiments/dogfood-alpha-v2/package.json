    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "lefthook": "^1.10.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0-beta.7",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
