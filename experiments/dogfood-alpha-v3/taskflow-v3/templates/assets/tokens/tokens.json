{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "shadcn/ui default style 토큰 풀셋. light + dark 모드 분리. OKLCH 색공간 사용. pnpm gd build-tokens 가 본 파일 → src/styles/globals.css 자동 생성.",

  "color": {
    "background": {
      "$type": "color",
      "$value": { "light": "oklch(1 0 0)", "dark": "oklch(0.145 0 0)" },
      "$description": "페이지 배경"
    },
    "foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" },
      "$description": "본문 텍스트"
    },

    "card": {
      "$type": "color",
      "$value": { "light": "oklch(1 0 0)", "dark": "oklch(0.205 0 0)" },
      "$description": "Card 배경"
    },
    "card-foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" },
      "$description": "Card 위 텍스트"
    },

    "popover": {
      "$type": "color",
      "$value": { "light": "oklch(1 0 0)", "dark": "oklch(0.269 0 0)" },
      "$description": "Popover / DropdownMenu 배경"
    },
    "popover-foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" },
      "$description": "Popover 위 텍스트"
    },

    "primary": {
      "$type": "color",
      "$value": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.922 0 0)" },
      "$description": "브랜드 메인 — Button default 배경"
    },
    "primary-foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.985 0 0)", "dark": "oklch(0.205 0 0)" },
      "$description": "primary 위 텍스트"
    },

    "secondary": {
      "$type": "color",
      "$value": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.269 0 0)" },
      "$description": "보조 surface — Button secondary"
    },
    "secondary-foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.985 0 0)" },
      "$description": "secondary 위 텍스트"
    },

    "muted": {
      "$type": "color",
      "$value": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.269 0 0)" },
      "$description": "약한 surface — Skeleton 배경"
    },
    "muted-foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.556 0 0)", "dark": "oklch(0.708 0 0)" },
      "$description": "약한 텍스트 — caption / 비활성"
    },

    "accent": {
      "$type": "color",
      "$value": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.371 0 0)" },
      "$description": "호버 / 강조 배경 — Button ghost hover"
    },
    "accent-foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.985 0 0)" },
      "$description": "accent 위 텍스트"
    },

    "destructive": {
      "$type": "color",
      "$value": { "light": "oklch(0.577 0.245 27.325)", "dark": "oklch(0.704 0.191 22.216)" },
      "$description": "위험 / 에러 — Button destructive"
    },
    "destructive-foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.985 0 0)", "dark": "oklch(0.205 0 0)" },
      "$description": "destructive 위 텍스트. dark 모드는 밝은 빨강 위 어두운 텍스트 (WCAG AA — spec-11-05 hotfix)"
    },

    "border": {
      "$type": "color",
      "$value": { "light": "oklch(0.922 0 0)", "dark": "oklch(1 0 0 / 0.1)" },
      "$description": "외곽선 (Card / Separator)"
    },
    "input": {
      "$type": "color",
      "$value": { "light": "oklch(0.922 0 0)", "dark": "oklch(1 0 0 / 0.15)" },
      "$description": "Input / TextField 외곽선"
    },
    "ring": {
      "$type": "color",
      "$value": { "light": "oklch(0.708 0 0)", "dark": "oklch(0.556 0 0)" },
      "$description": "포커스 링 (focus-visible)"
    },

    "chart-1": {
      "$type": "color",
      "$value": { "light": "oklch(0.646 0.222 41.116)", "dark": "oklch(0.488 0.243 264.376)" },
      "$description": "Chart 시리즈 1 — 데이터 시각화"
    },
    "chart-2": {
      "$type": "color",
      "$value": { "light": "oklch(0.6 0.118 184.704)", "dark": "oklch(0.696 0.17 162.48)" },
      "$description": "Chart 시리즈 2"
    },
    "chart-3": {
      "$type": "color",
      "$value": { "light": "oklch(0.398 0.07 227.392)", "dark": "oklch(0.769 0.188 70.08)" },
      "$description": "Chart 시리즈 3"
    },
    "chart-4": {
      "$type": "color",
      "$value": { "light": "oklch(0.828 0.189 84.429)", "dark": "oklch(0.627 0.265 303.9)" },
      "$description": "Chart 시리즈 4"
    },
    "chart-5": {
      "$type": "color",
      "$value": { "light": "oklch(0.769 0.188 70.08)", "dark": "oklch(0.645 0.246 16.439)" },
      "$description": "Chart 시리즈 5"
    },

    "sidebar": {
      "$type": "color",
      "$value": { "light": "oklch(0.985 0 0)", "dark": "oklch(0.205 0 0)" },
      "$description": "Sidebar 배경"
    },
    "sidebar-foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" },
      "$description": "Sidebar 텍스트"
    },
    "sidebar-primary": {
      "$type": "color",
      "$value": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.488 0.243 264.376)" },
      "$description": "Sidebar active item"
    },
    "sidebar-primary-foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.985 0 0)", "dark": "oklch(0.985 0 0)" },
      "$description": "Sidebar active 위 텍스트"
    },
    "sidebar-accent": {
      "$type": "color",
      "$value": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.269 0 0)" },
      "$description": "Sidebar hover item"
    },
    "sidebar-accent-foreground": {
      "$type": "color",
      "$value": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.985 0 0)" },
      "$description": "Sidebar hover 위 텍스트"
    },
    "sidebar-border": {
      "$type": "color",
      "$value": { "light": "oklch(0.922 0 0)", "dark": "oklch(1 0 0 / 0.1)" },
      "$description": "Sidebar 외곽선"
    },
    "sidebar-ring": {
      "$type": "color",
      "$value": { "light": "oklch(0.708 0 0)", "dark": "oklch(0.439 0 0)" },
      "$description": "Sidebar 포커스 링"
    }
  },

  "radius": {
    "base": {
      "$type": "dimension",
      "$value": "0.625rem",
      "$description": "기본 모서리 반지름. sm / md / lg / xl 은 base 에서 파생 (globals.css 의 @theme inline)."
    }
  },

  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": "Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
      "$description": "본문 sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, \"SF Mono\", \"Menlo\", monospace",
      "$description": "코드 monospace"
    }
  }
}
